# APP_MODE=demo seeds clearly marked sample users and one sample Fuzhou route.
# Use APP_MODE=real for a separate database with no demo content.
APP_MODE=demo
CITYTRACE_HOST=127.0.0.1
CITYTRACE_PORT=8002
CITYTRACE_BIND_ADDRESS=127.0.0.1
CITYTRACE_DATA_DIR=./data

# Optional legal AMap JavaScript API credentials. Leave blank to show coordinate plots only.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# Required together to bootstrap an administrator on first real-mode startup.
CITYTRACE_ADMIN_EMAIL=
CITYTRACE_ADMIN_PASSWORD=
